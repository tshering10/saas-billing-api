APP_NAME=saas-billing-api
APP_ENV=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://billing_user:billing_password@postgres:5432/billing_db
ALEMBIC_DATABASE_URL=postgresql+psycopg://billing_user:billing_password@localhost:5432/billing_db

REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30